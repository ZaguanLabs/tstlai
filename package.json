{
  "name": "tstlai",
  "version": "1.2.8",
  "description": "Just-In-Time AI localization engine with intelligent caching",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tstlai": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/integrations/next-client.d.ts",
      "default": "./dist/integrations/next-client.js"
    },
    "./next": {
      "types": "./dist/integrations/next.d.ts",
      "default": "./dist/integrations/next.js"
    },
    "./integrations": {
      "types": "./dist/integrations/index.d.ts",
      "default": "./dist/integrations/index.js"
    },
    "./integrations/next-intl": {
      "types": "./dist/integrations/next-intl.d.ts",
      "default": "./dist/integrations/next-intl.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./languages": {
      "types": "./dist/languages.d.ts",
      "default": "./dist/languages.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./express": {
      "types": "./dist/integrations/express.d.ts",
      "default": "./dist/integrations/express.js"
    },
    "./fastify": {
      "types": "./dist/integrations/fastify.d.ts",
      "default": "./dist/integrations/fastify.js"
    },
    "./astro": {
      "types": "./dist/integrations/astro.d.ts",
      "default": "./dist/integrations/astro.js"
    },
    "./remix": {
      "types": "./dist/integrations/remix.d.ts",
      "default": "./dist/integrations/remix.js"
    },
    "./package.json": "./package.json",
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint 'src/**/*.{ts,tsx}' --max-warnings=0",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,json,md}'",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "test:package": "npm run build && node scripts/check-package.cjs",
    "validate": "npm run check-types && npm run lint && npm test -- --runInBand && npm run test:package",
    "prepack": "npm run build"
  },
  "keywords": [
    "i18n",
    "translation",
    "localization",
    "ai",
    "nextjs",
    "typescript"
  ],
  "author": "Zaguán AI",
  "license": "MIT",
  "homepage": "https://labs.zaguanai.com/en/experiments/tstlai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZaguanLabs/tstlai.git"
  },
  "bugs": {
    "url": "https://github.com/ZaguanLabs/tstlai/issues"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jsdom": "26.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "ioredis": "^5.11.1",
    "node-html-parser": "^9.0.3",
    "openai": "^6.49.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
